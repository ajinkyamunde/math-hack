# ---------------------------------------------------------------------------
# MathHack configuration. Copy to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development
PORT=4000

# MongoDB Atlas or a replica set (transactions/change streams need one; Atlas always qualifies).
# Example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/mathhack?retryWrites=true&w=majority
MONGODB_URI=MONGODB_URI=mongodb+srv://jnkmunde_db_user:bJY2pmqvS43td_C@cluster0.jk7mzea.mongodb.net/mathhack?compressors=zlib&retryWrites=true&w=majority

# Exact origin of the React app (used for CORS, CSRF origin checks and Socket.IO).
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:4000

# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=7YfT2UsI0GKaM913gb2RD-ElkKQ90oDz-5EYVTZCTjPS59VZ3eA_QCBelDAYk3ww
SESSION_TTL_HOURS=12

# Leave empty for host-only cookies. lax works when frontend and backend share a site
# (e.g. app.college.edu + api.college.edu); use none (https only) for different sites.
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax

# Number of reverse proxies in front of the backend (Render/Railway/Nginx usually 1).
TRUST_PROXY=0

# Initial host account, read only by `npm run create-host`. Remove from the environment afterwards.
HOST_INITIAL_NAME=
HOST_INITIAL_EMAIL=
HOST_INITIAL_PASSWORD=

# Optional: Redis for multi-instance Socket.IO (leave empty for a single backend instance).
REDIS_URL=

# Optional: email verification. Without SMTP_HOST, accounts stay "unverified" and the UI says so.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
REQUIRE_EMAIL_VERIFICATION=false

# Optional: require registrations to match an uploaded official roster (PRN + email).
ROSTER_ENFORCED=false

# Development only. Ignored (rejected) in production.
RATE_LIMIT_DISABLED=false

# Frontend (Vite) build-time settings: the backend URL the browser talks to.
VITE_API_URL=http://localhost:4000
